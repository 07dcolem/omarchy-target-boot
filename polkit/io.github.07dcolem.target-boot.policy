<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Reboot into</vendor>
  <vendor_url>https://github.com/07dcolem/omarchy-target-boot</vendor_url>
  <action id="io.github.07dcolem.target-boot.supervise">
    <description>Set the next boot</description>
    <message>Authentication is required to set the next boot</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/io.github.07dcolem.target-boot/supervise</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="io.github.07dcolem.target-boot.arm-usb">
    <description>Set the next boot to a USB drive</description>
    <message>Authentication is required to set the next boot to a USB drive</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/io.github.07dcolem.target-boot/arm-usb</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
