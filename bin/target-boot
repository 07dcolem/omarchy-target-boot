#!/usr/bin/bash
# shellcheck shell=bash
#
# Read the firmware boot menu and set the one-shot BootNext variable.
#
# The write path is two calls and nothing else:
#   /usr/bin/efibootmgr --bootnext XXXX
#   /usr/bin/efibootmgr --delete-bootnext
# A read is `/usr/bin/efibootmgr` with no arguments. Boot order is parsed so
# it can be compared after a write. It is never passed back to efibootmgr.

set -euo pipefail
IFS=$' \t\n'

VERSION="1.0.1"

# Privileged programs are absolute paths. PATH is reset to system directories
# before any other command is looked up, and nothing looked up on PATH is
# passed to sudo or pkexec.
EFIBOOTMGR=/usr/bin/efibootmgr
SUDO=/usr/bin/sudo
PKEXEC=/usr/bin/pkexec
JQ=/usr/bin/jq
SYSTEMCTL=/usr/bin/systemctl
OMARCHY_REBOOT=/usr/bin/omarchy-system-reboot
OMARCHY_BIN=/usr/share/omarchy/bin

# Root-owned, not writable by group or other. A symlink is accepted only when
# its final target stays under /usr or /bin and passes the same checks.
trusted_path() {
  local path=$1 want_exec=$2 owner mode target perm
  [[ $path == /* && -e $path ]] || return 1
  if [[ -L $path ]]; then
    target=$(readlink -f -- "$path") || return 1
    [[ $target == /usr/* || $target == /bin/* || $target == /sbin/* ]] || return 1
    path=$target
  fi
  [[ $want_exec == file && -f $path && -x $path ]] || [[ $want_exec == dir && -d $path ]] || return 1
  owner=$(stat -c '%u' -- "$path") || return 1
  mode=$(stat -c '%a' -- "$path") || return 1
  [[ $owner == 0 && $mode =~ ^[0-7]+$ ]] || return 1
  perm=$((8#$mode))
  (( (perm & 0022) == 0 )) || return 1
}

trusted_executable() { trusted_path "$1" file; }
trusted_dir() { trusted_path "$1" dir; }

# Drop the caller's environment and come back with only the session values
# the polkit prompt and the user-session reboot need. A caller-supplied
# marker is not enough: PATH and the loader variables have to match too.
sanitize_environment() {
  local base=/usr/bin:/bin
  local dirty=0
  [[ ${TARGET_BOOT_SANITIZED:-} == 1 ]] || dirty=1
  [[ ${PATH:-} == "$base" ]] || dirty=1
  [[ -z ${LD_PRELOAD:-}${LD_LIBRARY_PATH:-}${BASH_ENV:-}${ENV:-} ]] || dirty=1
  if (( dirty )); then
    exec /usr/bin/env -i \
      TARGET_BOOT_SANITIZED=1 \
      PATH="$base" \
      HOME="${HOME-}" \
      USER="${USER-}" \
      LOGNAME="${LOGNAME-${USER-}}" \
      XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR-}" \
      DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS-}" \
      WAYLAND_DISPLAY="${WAYLAND_DISPLAY-}" \
      DISPLAY="${DISPLAY-}" \
      XAUTHORITY="${XAUTHORITY-}" \
      LANG="${LANG-}" \
      LC_ALL="${LC_ALL-}" \
      /usr/bin/bash -- "$0" "$@"
  fi
  unset LD_PRELOAD LD_LIBRARY_PATH BASH_ENV ENV
  export PATH="$base"
  if trusted_dir "$OMARCHY_BIN"; then
    export PATH="$base:$OMARCHY_BIN"
  fi
}

jq() { "$JQ" "$@"; }

fail() {
  jq -cn --arg error "$1" '{ok:false, error:$error}'
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  target-boot list [--fixture FILE]
  target-boot bootnext HEXID [--dry-run] [--fixture FILE]
  target-boot clear-next [--dry-run] [--fixture FILE]
  target-boot reboot-into HEXID [--dry-run] [--fixture FILE]

list prints the firmware boot entries as JSON.
bootnext writes BootNext and leaves every other firmware setting alone.
clear-next removes BootNext.
reboot-into writes BootNext, checks that it stuck and that the boot order
is unchanged, then reboots through /usr/bin/omarchy-system-reboot.

--dry-run prints the argv it would run and does not touch firmware.
--fixture reads a saved firmware listing. A fixture is refused for a real write.
EOF
}

json_argv() {
  if (($# == 0)); then
    printf '[]\n'
    return
  fi
  printf '%s\n' "$@" | jq -R . | jq -cs .
}

capture() {
  local out err
  out=$(mktemp)
  err=$(mktemp)
  set +e
  "$@" >"$out" 2>"$err"
  CAP_STATUS=$?
  set -e
  CAP_OUT=$(cat -- "$out")
  CAP_ERR=$(cat -- "$err")
  rm -f -- "$out" "$err"
}

# Root via passwordless sudo when the machine offers it, otherwise the
# session polkit agent. The elevated program is the pinned efibootmgr, never
# a path taken from PATH. pkexec treats a leading -- as the program name, so
# the binary is the first argument. The helper itself stays the logged-in
# user so the reboot runs in that user's systemd session.
require_efi() {
  trusted_executable "$EFIBOOTMGR" || fail "efibootmgr is not installed"
}

efi_exec() {
  require_efi
  if [[ $(id -u) -eq 0 ]]; then
    capture "$EFIBOOTMGR" "$@"
    return
  fi
  if trusted_executable "$SUDO" && "$SUDO" -n /usr/bin/true >/dev/null 2>&1; then
    capture "$SUDO" -n -- "$EFIBOOTMGR" "$@"
    return
  fi
  if ! trusted_executable "$PKEXEC"; then
    CAP_STATUS=127
    CAP_OUT=""
    CAP_ERR="pkexec was not found"
    return
  fi
  capture "$PKEXEC" "$EFIBOOTMGR" "$@"
}

efi_detail() {
  local detail=${CAP_ERR:-${CAP_OUT:-}}
  detail=${detail//$'\n'/ }
  detail=${detail#"${detail%%[![:space:]]*}"}
  detail=${detail%"${detail##*[![:space:]]}"}
  printf '%s\n' "$detail"
}

efi_file() {
  local path=$1
  local lower=${path,,}
  local key="\\efi\\"
  local head=${lower%%"$key"*}
  if [[ $head == "$lower" ]]; then
    key="/efi/"
    head=${lower%%"$key"*}
    if [[ $head == "$lower" ]]; then
      printf '\n'
      return
    fi
  fi
  local slice=${path:${#head}}
  if [[ $slice =~ ^([^[:space:]]*\.[Ee][Ff][Ii]) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return
  fi
  printf '\n'
}

trim() {
  local value=$1
  value=${value#"${value%%[![:space:]]*}"}
  value=${value%"${value##*[![:space:]]}"}
  printf '%s\n' "$value"
}

parse_listing() {
  local raw=$1
  local boot_current="" boot_next="" order_csv=""
  local entries='[]'
  local line id mark rest label path file active

  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    if [[ $line =~ ^BootCurrent:[[:space:]]*([0-9A-Fa-f]{4})[[:space:]]*$ ]]; then
      boot_current=${BASH_REMATCH[1]^^}
    elif [[ $line =~ ^BootNext:[[:space:]]*([0-9A-Fa-f]{4})[[:space:]]*$ ]]; then
      boot_next=${BASH_REMATCH[1]^^}
    elif [[ $line =~ ^BootOrder:[[:space:]]*([0-9A-Fa-f,[:space:]]+)[[:space:]]*$ ]]; then
      order_csv=${BASH_REMATCH[1]//[[:space:]]/}
      order_csv=${order_csv^^}
    elif [[ $line =~ ^Boot([0-9A-Fa-f]{4})([*[:space:]])[[:space:]](.*)$ ]]; then
      id=${BASH_REMATCH[1]^^}
      mark=${BASH_REMATCH[2]}
      rest=${BASH_REMATCH[3]}
      active=false
      [[ $mark == "*" ]] && active=true
      label=$rest
      path=""
      if [[ $rest == *$'\t'* ]]; then
        label=${rest%%$'\t'*}
        path=${rest#*$'\t'}
      fi
      label=$(trim "$label")
      file=$(efi_file "$path")
      entries=$(jq -c \
        --arg id "$id" \
        --argjson active "$active" \
        --arg label "$label" \
        --arg path "$path" \
        --arg file "$file" \
        '. + [{id:$id, active:$active, label:$label, path:$path, file:$file}]' <<<"$entries")
    fi
  done <<<"$raw"

  jq -c \
    --arg current "$boot_current" \
    --arg next "$boot_next" \
    --arg order "$order_csv" \
    '
      ($order | split(",") | map(select(length > 0))) as $ids
      | . as $all
      | [ $ids[] as $id | $all[] | select(.id == $id) ] as $ordered
      | [ $all[] | select(.id as $id | ($ids | index($id)) == null) ] as $rest
      | ($ordered + $rest) as $rows
      | {
          ok: true,
          bootCurrent: (if $current == "" then null else $current end),
          bootNext: (if $next == "" then null else $next end),
          bootOrder: $ids,
          entries: ($rows | map(. + {
            current: (.id == $current),
            next: ($next != "" and .id == $next)
          }))
        }
    ' <<<"$entries"
}

load_firmware() {
  local raw
  if [[ -n ${FIXTURE:-} ]]; then
    if [[ ! -f $FIXTURE ]]; then
      PARSED=$(jq -cn '{ok:false, error:"Fixture could not be read"}')
      return 1
    fi
    raw=$(cat -- "$FIXTURE")
  else
    if ! trusted_executable "$EFIBOOTMGR"; then
      PARSED=$(jq -cn '{ok:false, error:"efibootmgr is not installed"}')
      return 1
    fi
    capture "$EFIBOOTMGR"
    if [[ ${CAP_STATUS:-1} -ne 0 ]]; then
      local detail
      detail=$(efi_detail)
      PARSED=$(jq -cn --arg error "Could not read the EFI boot entries. ${detail}" '{ok:false, error:$error}')
      return 1
    fi
    raw=$CAP_OUT
  fi

  if ! PARSED=$(parse_listing "$raw"); then
    PARSED=$(jq -cn '{ok:false, error:"Could not read the EFI boot entries"}')
    return 1
  fi
  if ! jq -e '.bootCurrent != null or (.entries | length) > 0' <<<"$PARSED" >/dev/null; then
    PARSED=$(jq -cn '{ok:false, error:"Could not read the EFI boot entries"}')
    return 1
  fi
}

normalize_id() {
  local id=${1^^}
  [[ $id =~ ^[0-9A-F]{4}$ ]] || return 1
  printf '%s\n' "$id"
}

require_known() {
  local id=$1
  if ! jq -e --arg id "$id" 'any(.entries[]; .id == $id)' <<<"$PARSED" >/dev/null; then
    fail "That operating system is not in the firmware list"
  fi
}

order_csv() {
  jq -r '.bootOrder | join(",")' <<<"$PARSED"
}

boot_next_value() {
  jq -r '.bootNext // empty' <<<"$PARSED"
}

refuse_fixture_write() {
  if [[ -n ${FIXTURE:-} && ${1:-0} -eq 0 ]]; then
    fail "A fixture cannot be used when writing firmware"
  fi
}

auth_failure() {
  local what=$1 detail
  detail=$(efi_detail)
  if [[ ${CAP_STATUS:-1} -eq 126 ]]; then
    fail "Authorization was declined, so ${what}"
  fi
  if [[ ${CAP_STATUS:-1} -eq 127 ]]; then
    case $detail in
      ""|*"Not authorized"*|*"Request dismissed"*|*"Authentication failed"*)
        fail "Authorization was declined, so ${what}"
        ;;
    esac
  fi
  if [[ -n $detail ]]; then
    fail "Could not ${what}. ${detail}"
  fi
  fail "Could not ${what}"
}

cmd_list() {
  load_firmware || { printf '%s\n' "$PARSED"; exit 1; }
  printf '%s\n' "$PARSED"
}

cmd_bootnext() {
  local id dry=$1
  shift
  if ! id=$(normalize_id "${1:-}"); then
    fail "Boot id must be four hex digits"
  fi
  refuse_fixture_write "$dry"
  load_firmware || { printf '%s\n' "$PARSED"; exit 1; }
  require_known "$id"
  local before
  before=$(order_csv)

  if [[ $dry -eq 1 ]]; then
    local argv
    argv=$(json_argv "$EFIBOOTMGR" --bootnext "$id")
    jq -cn --arg id "$id" --arg order "$before" --argjson argv "$argv" \
      '{ok:true, dryRun:true, action:"bootnext", id:$id, argv:$argv, bootOrder:($order | split(",") | map(select(length > 0)))}'
    return
  fi

  efi_exec --bootnext "$id"
  if [[ ${CAP_STATUS:-1} -ne 0 ]]; then
    auth_failure "set next boot"
  fi

  load_firmware || { printf '%s\n' "$PARSED"; exit 1; }
  local after next
  after=$(order_csv)
  next=$(boot_next_value)
  if [[ $before != "$after" ]]; then
    fail "The firmware boot order changed, so nothing further was run"
  fi
  if [[ $next != "$id" ]]; then
    fail "Next boot did not stick. The reboot was not started"
  fi
  jq -cn --arg id "$id" '{ok:true, action:"bootnext", id:$id, bootNext:$id}'
}

cmd_clear() {
  local dry=$1
  refuse_fixture_write "$dry"
  load_firmware || { printf '%s\n' "$PARSED"; exit 1; }
  local before next
  before=$(order_csv)
  next=$(boot_next_value)

  if [[ $dry -eq 1 ]]; then
    local argv
    argv=$(json_argv "$EFIBOOTMGR" --delete-bootnext)
    jq -cn --argjson argv "$argv" '{ok:true, dryRun:true, action:"clear-next", argv:$argv}'
    return
  fi

  if [[ -z $next ]]; then
    jq -cn '{ok:true, action:"clear-next", bootNext:null}'
    return
  fi

  efi_exec --delete-bootnext
  if [[ ${CAP_STATUS:-1} -ne 0 ]]; then
    auth_failure "clear next boot"
  fi

  load_firmware || { printf '%s\n' "$PARSED"; exit 1; }
  local after
  after=$(order_csv)
  next=$(boot_next_value)
  if [[ $before != "$after" ]]; then
    fail "The firmware boot order changed, so nothing further was run"
  fi
  if [[ -n $next ]]; then
    fail "Next boot is still set"
  fi
  jq -cn '{ok:true, action:"clear-next", bootNext:null}'
}

reboot_command() {
  if trusted_executable "$OMARCHY_REBOOT"; then
    REBOOT_CMD=("$OMARCHY_REBOOT")
  elif trusted_executable "$SYSTEMCTL"; then
    REBOOT_CMD=("$SYSTEMCTL" reboot --no-wall)
  else
    fail "Could not find a reboot command"
  fi
}

cmd_reboot_into() {
  local id dry=$1
  shift
  if ! id=$(normalize_id "${1:-}"); then
    fail "Boot id must be four hex digits"
  fi
  refuse_fixture_write "$dry"
  load_firmware || { printf '%s\n' "$PARSED"; exit 1; }
  require_known "$id"
  local before
  before=$(order_csv)
  reboot_command

  if [[ $dry -eq 1 ]]; then
    local argv reboot
    argv=$(json_argv "$EFIBOOTMGR" --bootnext "$id")
    reboot=$(json_argv "${REBOOT_CMD[@]}")
    jq -cn --arg id "$id" --argjson argv "$argv" --argjson reboot "$reboot" \
      '{ok:true, dryRun:true, action:"reboot-into", id:$id, argv:$argv, reboot:$reboot}'
    return
  fi

  efi_exec --bootnext "$id"
  if [[ ${CAP_STATUS:-1} -ne 0 ]]; then
    auth_failure "set next boot"
  fi

  load_firmware || { printf '%s\n' "$PARSED"; exit 1; }
  local after next
  after=$(order_csv)
  next=$(boot_next_value)
  if [[ $before != "$after" ]]; then
    fail "The firmware boot order changed, so the reboot was not started"
  fi
  if [[ $next != "$id" ]]; then
    fail "Next boot did not stick, so the reboot was not started"
  fi

  capture "${REBOOT_CMD[@]}"
  if [[ ${CAP_STATUS:-1} -ne 0 ]]; then
    local detail
    detail=$(efi_detail)
    if [[ -n $detail ]]; then
      fail "Next boot is set to ${id}, and the reboot did not start. ${detail}"
    fi
    fail "Next boot is set to ${id}, and the reboot did not start"
  fi
  jq -cn --arg id "$id" '{ok:true, action:"reboot-into", id:$id, bootNext:$id}'
}

sanitize_environment "$@"

if ! trusted_executable "$JQ"; then
  printf '%s\n' '{"ok":false,"error":"jq is not installed"}'
  exit 1
fi

FIXTURE=""
DRY=0
POSITIONAL=()

while (($# > 0)); do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --version)
      printf '%s\n' "$VERSION"
      exit 0
      ;;
    --fixture)
      [[ -n ${2:-} ]] || fail "Pass a file after --fixture"
      FIXTURE=$2
      shift 2
      ;;
    --dry-run)
      DRY=1
      shift
      ;;
    --)
      shift
      POSITIONAL+=("$@")
      break
      ;;
    -*)
      fail "Unknown option: $1"
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

cmd=${POSITIONAL[0]:-}
case "$cmd" in
  list)
    [[ ${#POSITIONAL[@]} -eq 1 ]] || fail "list takes no arguments"
    cmd_list
    ;;
  bootnext)
    [[ ${#POSITIONAL[@]} -eq 2 ]] || fail "bootnext takes the four digit boot id"
    cmd_bootnext "$DRY" "${POSITIONAL[1]}"
    ;;
  clear-next)
    [[ ${#POSITIONAL[@]} -eq 1 ]] || fail "clear-next takes no arguments"
    cmd_clear "$DRY"
    ;;
  reboot-into)
    [[ ${#POSITIONAL[@]} -eq 2 ]] || fail "reboot-into takes the four digit boot id"
    cmd_reboot_into "$DRY" "${POSITIONAL[1]}"
    ;;
  "")
    usage >&2
    fail "Choose list, bootnext, clear-next, or reboot-into"
    ;;
  *)
    fail "Unknown command: $cmd"
    ;;
esac
