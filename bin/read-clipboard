#!/usr/bin/bash
# Read one short clipboard offer for the rename field.
#
# The shell must not pull a foreign clipboard body itself. This process asks
# wl-paste for text/plain, stops after one second, and keeps at most MAX_PASTE
# bytes. A longer offer is cut at that byte, not loaded and then trimmed.

MAX_PASTE=320

read_capped() {
  local max=$1
  shift
  local out
  [[ $max =~ ^[1-9][0-9]{0,3}$ ]] || return 2
  [ "$max" -le 1024 ] || return 2
  # head closes the pipe after max+1 bytes. The extra byte is how overflow
  # is detected. || true keeps a short read when the producer is killed.
  out=$(LC_ALL=C "$@" 2>/dev/null | /usr/bin/head -c $((max + 1))) || true
  LC_ALL=C
  if [ "${#out}" -gt "$max" ]; then
    out=${out:0:max}
  fi
  printf '%s' "$out"
}

run_paste() {
  local mode=${1:-} extra=()
  case $mode in
    clipboard) ;;
    primary) extra=(--primary) ;;
    *) return 2 ;;
  esac
  read_capped "$MAX_PASTE" \
    /usr/bin/timeout -k 1 -- 1 \
    /usr/bin/wl-paste --no-newline --type text/plain "${extra[@]}"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  set -u
  run_paste "$@"
fi
